# =============================================
# Intelligent Digital Forensic AI Assistant — Config
# =============================================
# 1. Copy this file: cp .env.example .env
# 2. Generate a secret key:
#    python3 -c "import secrets; print(secrets.token_hex(32))"
# 3. Paste the output as SECRET_KEY below
# =============================================

# Database
DATABASE_URL=sqlite:///./data/forensic.db

# File storage
CASES_DIR=./data/cases

# Application
APP_NAME=Intelligent Digital Forensic AI Assistant
APP_VERSION=1.0.0
DEBUG=False

# Security — CHANGE THIS before running
SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_KEY

# AI Model
# For GTX 1050 Ti (4GB VRAM): phi4-mini
# For M1/M2 Mac (8GB): llama3.2:3b
# For GPU with 8GB+ VRAM: qwen2.5:7b
OLLAMA_MODEL=llama3.2:3b

# Ollama server URL
OLLAMA_BASE_URL=http://localhost:11434

# Context window, in tokens, requested from Ollama on every query.
#
# This is the single biggest lever on answer quality, and it is a REQUEST, not
# a hope: it is sent as options.num_ctx. Leave it unset and Ollama applies its
# own default (4,096 for llama3.2), which is 32x smaller than what the model
# was trained for, and every prompt beyond 4,096 tokens is accepted, silently
# truncated, and answered from its tail -- the evidence is discarded and the
# reply still looks successful. That is the failure mode, not a hypothetical.
#
# It is clamped down automatically to the selected model's real capability
# (read from /api/show), so a smaller model gets a smaller window rather than
# an error. Raise it if RAM allows; each doubling costs KV-cache memory and
# prefill time. A smaller window degrades to less evidence per answer, never to
# a confidently wrong one.
OLLAMA_NUM_CTX=16384

# Sampling seed, sent as options.seed on every query.
#
# A fixed seed is what makes an answer reproducible: the same evidence and the
# same question give the same answer, so an investigator who quotes one in a
# report can re-run the query and get it back. This matters because temperature
# is 0.1, which still samples - two runs would otherwise differ.
#
# Set -1 to opt out (llama.cpp reads a negative seed as random). There is no
# reason to, other than wanting to sample the same question several times.
OLLAMA_SEED=42
