# Python generated files
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local environments and secrets
.venv/
.env
.env.*
!.env.example

# The Ollama bundle and package cache ship with Desktop-Application. Git LFS
# stores the large wheel/model layers; local derived runtimes are reproducible.
/models/*
!/models/ollama/
/tools/

# Local database snapshots
idfa_backup.db

# Per-machine configuration lives in %APPDATA%\IDFA; the template is committed
config.yaml

# Runtime output
*.log
